# Machine-specific settings. Everything here is optional: the defaults are the
# ones the script has always used, so an empty file (or no file) still runs.
#
#   key = value        # '#' starts a comment, blanks are ignored
#
# Paths may be absolute or relative to the folder holding config/, data/ and
# logs/ (the folder you pass with --root, or the current directory).

# --- destinations -----------------------------------------------------------
# Named roots. A site picks one with `dest=NAME` in config/sites.txt; everything
# else goes to destination_default. `layout` decides the folder shape:
#   creator = one folder per uploader/creator (the tpl below)
#   flat    = files straight into the root
# A destination may set its own `tpl`; otherwise tpl_default/tpl_flat apply.
# Add as many [dest:NAME] sections as you need (music, books, a second drive).
[dest:default]
path = E:\Downloads
layout = creator

[dest:flat]
path = E:\Downloads\misc
layout = flat

destination_default = default

# Only destinations on the default destination's drive are moved to a fallback
# drive when it is missing or has less than dest_fallback_below_gb GB free; only
# the drive letter changes, so the trees stay mergeable.
dest_fallback = D:,G:
dest_fallback_below_gb = 20

# Legacy keys, still read when there are no [dest:...] sections:
#   dest_default = E:\Downloads
#   dest_flat    = E:\Downloads\misc

# --- naming -----------------------------------------------------------------
# yt-dlp templates. Per-site templates are tpl= lines in config/sites.txt;
# a destination's tpl= wins over these.
tpl_default = %(uploader,channel,creator,artist,extractor|NA)s/%(title).200s.%(ext)s
tpl_flat = %(title).200s.%(ext)s
tpl_generic = %(title).200s.%(ext)s
# gallery-dl folder rule (alternatives syntax: first non-empty key wins).
gdl_dir = {tag_string_artist|tags_artist[0]|uploader|uploader_name|channel|artist|creator[full_name]|creator[vanity]|creator[name]|creator[username]|creator|username|user[name]|author[name]|author|account[username]|category}

# --- engines ----------------------------------------------------------------
# '' = auto-detect (winget Links folder, then PATH, then the winget package
# folder). A file-host engine is a folder; the exe is searched for inside it, so
# a version bump needs no edit.
max_downloads = 4
yt = 
gdl = 
megatools = D:\Warez\megatools
mediafire = D:\Warez\mediafire_rs

# --- login cookies ----------------------------------------------------------
# Browser to export cookies from on startup ('' = never refresh). Firefox-family
# browsers can be open; Chromium-based ones lock their cookie database.
cookies_browser = floorp

# --- runtime ----------------------------------------------------------------
idle_seconds = 3
progress_every_seconds = 15
fold_batch_rows = 25
fold_batch_seconds = 60
